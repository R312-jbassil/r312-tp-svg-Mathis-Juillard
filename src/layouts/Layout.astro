---
// Layout.astro
import "../styles/global.css";
import { ui } from "../i18n/ui.js";
const locale: 'en' | 'fr' = (Astro.locals.lang === 'fr' ? 'fr' : 'en');
const user = Astro.locals.user; 
---

<!doctype html>
<html lang={locale} class="h-full">
  <head>
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem('theme');
          if (t) document.documentElement.setAttribute('data-theme', t);
          else document.documentElement.setAttribute('data-theme', 'light'); // défaut
        } catch {}
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title ?? "App"}</title>
  </head>

  <body class="h-full">
    <header class="navbar bg-base-200 sticky top-0 z-50">
      <div class="flex-1 gap-2">
        <a href="/" class="btn btn-ghost text-lg">{ui[locale].nav.home}</a>
        <a href="/generator" class="btn btn-ghost">{ui[locale].nav.generator}</a>
        <a href="/gallery" class="btn btn-ghost">{ui[locale].nav.gallery}</a>
      </div>

      <div class="flex items-center gap-3">
        <!-- THEME DROPDOWN -->
        <details class="dropdown dropdown-end">
          <summary class="btn btn-ghost">{ui[locale].nav.theme ?? "Theme"}</summary>
          <ul class="menu dropdown-content bg-base-200 rounded-box shadow z-[60] mt-3 w-40 p-2">
            <li><button type="button" class="theme-item" data-theme="light">
              {ui[locale].theme?.light ?? "Light"}
            </button></li>
            <li><button type="button" class="theme-item" data-theme="dark">
              {ui[locale].theme?.dark ?? "Dark"}
            </button></li>
          </ul>
        </details>

        <!-- LANG SWITCH -->
        <form method="POST" action={Astro.url.pathname} class="inline-block">
          <select name="language" class="select select-sm" onchange="this.form.submit()">
            <option disabled selected>{ui[locale].nav.language}</option>
            <option value="en" selected={locale === 'en'}>English</option>
            <option value="fr" selected={locale === 'fr'}>Français</option>
          </select>
        </form>
      </div>
       { !user ? (
  <div class="flex items-center gap-2">
    <a href="/login" class="btn btn-ghost btn-sm">Se connecter</a>
    <a href="/signup" class="btn btn-primary btn-sm">Créer un compte</a>
  </div>
) : (
          /* Quand connecté : petit badge + bouton LOGOUT */
          <div class="flex items-center gap-2">
            <span class="badge badge-outline hidden sm:inline">
              {user?.email ?? user?.name ?? 'User'}
            </span>
            <form method="POST" action="/api/logout" class="m-0">
              <button type="submit" class="btn btn-warning btn-sm">
                {ui[locale].nav.logout}
              </button>
            </form>
          </div>
          
        ) }
      </div>
      
    </header>

    <main class="h-full">
      <div class="h-full flex flex-col min-h-0">
        <div class="flex-1 min-h-0">
          <slot />
        </div>
      </div>
    </main>

    <!-- Script thème: appliquer + persister -->
    <script is:inline>
      function applyTheme(t) {
        document.documentElement.setAttribute('data-theme', t);
        try { localStorage.setItem('theme', t); } catch {}
        // Indiquer le bouton actif
        document.querySelectorAll('.theme-item')
          .forEach(btn => btn.classList.toggle('active', btn.dataset.theme === t));
      }

      // Clic sur un choix de thème
      document.addEventListener('click', (e) => {
        const btn = e.target.closest?.('.theme-item');
        if (!btn) return;
        const t = btn.dataset.theme;
        if (t) applyTheme(t);
      });

      // Synchroniser l’état actif au chargement
      (function initThemeUI() {
        const current = localStorage.getItem('theme') || 'light';
        applyTheme(current);
      })();
    </script>
  </body>
</html>
