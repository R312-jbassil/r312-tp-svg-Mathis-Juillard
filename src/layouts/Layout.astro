---
// src/layouts/Layout.astro
import "../styles/global.css";
import { ui } from "../i18n/ui.js";

// ✅ Une seule source de vérité : la locale du middleware
const locale: 'en' | 'fr' = (Astro.locals.lang === 'fr' ? 'fr' : 'en');
---

<!doctype html>
<html lang={locale} data-theme="light" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title ?? "App"}</title>
  </head>

  <body class="h-full">
    <!-- Header / Nav -->
    <header class="navbar bg-base-200 sticky top-0 z-50">
      <div class="flex-1 gap-2">
        <a href="/" class="btn btn-ghost text-lg">{ui[locale].nav.home}</a>
        <a href="/generator" class="btn btn-ghost">{ui[locale].nav.generator}</a>
        <a href="/gallery" class="btn btn-ghost">{ui[locale].nav.gallery}</a>
      </div>

      <div class="flex items-center gap-3">
        <!-- Sélecteur de thème (libellés traduits) -->
        <details class="dropdown dropdown-end">
          <summary class="btn btn-ghost">{ui[locale].nav.theme ?? "Theme"}</summary>
          <ul class="menu dropdown-content bg-base-200 rounded-box shadow z-[60] mt-3 w-40 p-2">
            <li><button type="button" data-set-theme="light">{ui[locale].theme?.light ?? "Light"}</button></li>
            <li><button type="button" data-set-theme="dark">{ui[locale].theme?.dark ?? "Dark"}</button></li>
          </ul>
        </details>

        <!-- Sélecteur de langue -->
        <form method="POST" action={Astro.url.pathname} class="inline-block">
          <select name="language" class="select select-sm" onchange="this.form.submit()">
            <option disabled selected>{ui[locale].nav.language}</option>
            <option value="en" selected={locale === 'en'}>English</option>
            <option value="fr" selected={locale === 'fr'}>Français</option>
          </select>
        </form>
      </div>
    </header>

    <main class="h-full">
      <div class="h-full flex flex-col min-h-0">
        <div class="flex-1 min-h-0">
          <slot />
        </div>
      </div>
    </main>

    <script>
      // petit switcher de thème (DaisyUI ou data-theme)
      document.addEventListener('click', (e) => {
        const t = /** @type {HTMLElement} */(e.target);
        const btn = t?.closest?.('[data-set-theme]');
        if (!btn) return;
        const theme = btn.getAttribute('data-set-theme');
        if (theme) document.documentElement.setAttribute('data-theme', theme);
      });
    </script>
  </body>
</html>
