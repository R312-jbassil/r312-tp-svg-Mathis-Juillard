---
import "../styles/global.css";
---
<!doctype html>
<html lang="fr" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>SVG Generator</title>
  </head>

  <body class="h-full bg-base-200">
    <header class="navbar bg-base-100/80 backdrop-blur border-b border-base-300">
      <div class="container mx-auto px-4">
        <div class="navbar-start">
          <a href="/" class="btn btn-ghost text-xl">SVG<span class="text-primary">Factory</span></a>
        </div>

        <div class="navbar-center hidden md:flex">
          <ul class="menu menu-horizontal gap-1">
            <li><a href="/" class="btn btn-ghost btn-sm">Accueil</a></li>
            <li><a href="/generator" class="btn btn-ghost btn-sm">Générateur</a></li>
            <li><a href="/gallery" class="btn btn-ghost btn-sm">Galerie</a></li>
          </ul>
        </div>

        <div class="navbar bg-base-100/80 backdrop-blur border-b border-base-300 sticky top-0 z-50">
    <div class="navbar-center">
      <span class="mr-2 font-medium">Thème</span>
      <div class="join relative z-50">
        <input class="btn btn-sm join-item theme-controller" type="radio" name="theme" aria-label="Light"  value="light" />
        <input class="btn btn-sm join-item theme-controller" type="radio" name="theme" aria-label="Dark"   value="dark" />
        <input class="btn btn-sm join-item theme-controller" type="radio" name="theme" aria-label="Bouncy" value="bouncyshark" />
      </div>
    </div>
  </div>
</header>

    </header>

    <main class="container mx-auto px-4 py-8 min-h-[calc(100dvh-4rem)]">
      <slot />
    </main>
  </body>
</html>
