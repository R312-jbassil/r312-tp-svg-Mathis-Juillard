---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <section class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-3">
      <a class="btn btn-ghost" href="/">← Accueil</a>
      <h1 class="text-2xl font-bold">SVG Generator</h1>
      <div class="badge badge-lg">OpenRouter</div>
    </div>
    <a class="btn btn-outline" href="/gallery">Galerie</a>
  </section>

  <!-- zone 1 : prompt -->
  <div class="card bg-base-100 shadow-xl border border-base-300 mb-6">
    <div class="card-body gap-3">
      <label class="form-control w-full">
        <div class="label">
          <span class="label-text">Prompt</span>
          <span class="label-text-alt">Décris l’objet à dessiner</span>
        </div>
        <textarea id="user-prompt" class="textarea textarea-bordered min-h-24" placeholder="a red car"></textarea>
      </label>

      <div class="card-actions justify-end gap-2">
        <button id="generate-button" class="btn btn-primary">Générer</button>
        <button id="edit-button" class="btn btn-secondary" disabled>Edit</button>
        <button id="save-button" class="btn btn-accent" disabled>Sauvegarder</button>
      </div>

      <div id="alert" class="hidden"></div>
    </div>
  </div>

  <!-- zones 2 & 3 : aperçu SVG + code SVG -->
  <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
    <div class="card bg-base-100 shadow-xl border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Aperçu</h2>
        <div id="svg-container" class="min-h-64 rounded-box border border-base-300 grid place-items-center">
          <span class="opacity-60">Le SVG généré s’affichera ici</span>
        </div>
      </div>
    </div>

<div class="card bg-base-100 shadow-xl border border-base-300">
  <div class="card-body">
    <div class="flex items-center justify-between">
      <h2 class="card-title">Code SVG</h2>
      <button id="copy-svg" class="btn btn-outline btn-sm">Copier le SVG</button>
    </div>

    <pre class="mockup-code text-sm overflow-auto max-h-[480px]">
      <code id="svg-output" class="whitespace-pre-wrap break-words"></code>
    </pre>
  </div>
</div>

</Layout>

<script type="module">
  // ----- Etat -----
  /** @type {{role:'user'|'assistant',content:string}[]} */
  let promptList = [];

  // ----- UI helpers -----
  const $ = (sel) => document.querySelector(sel);
  const btnGenerate = $('#generate-button');
  const btnEdit     = $('#edit-button');
  const btnSave     = $('#save-button');
  const out = $('#svg-output');
  const box = $('#svg-container');
  const alertBox = $('#alert');
  const promptEl = /** @type {HTMLTextAreaElement|null} */ (document.getElementById('user-prompt'));

  function showAlert(type, text) {
    alertBox.className = `alert alert-${type} mb-2`;
    alertBox.textContent = text;
  }

  async function callGenerate(messages) {
    const res = await fetch('/api/generateSVG', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(messages),
    });
    const data = await res.json(); // { svg: {role, content} } ou {error}
    if (!res.ok) throw new Error(data?.error || 'Erreur API');
    return data.svg; // {role:'assistant', content:'<svg...'}
  }

  async function handleSubmit() {
    const prompt = (promptEl?.value || '').trim();
    if (!prompt) return showAlert('warning', 'Écris un prompt avant de générer.');

    showAlert('info', 'Génération en cours…');
    btnGenerate.disabled = true; btnEdit.disabled = true; btnSave.disabled = true;
    box.innerHTML = `<span class="loading loading-ring loading-lg"></span>`;
    out.textContent = '';

    try {
      promptList.length = 0;
      promptList.push({ role: 'user', content: prompt });

      const aiMsg = await callGenerate(promptList); // {role, content}
      const match = aiMsg.content.match(/<svg[\s\S]*?<\/svg>/i);
      aiMsg.content = match ? match[0] : '';

      promptList.push(aiMsg);

      out.textContent = aiMsg.content;
      box.innerHTML   = aiMsg.content;
      showAlert('success', 'OK ✅');

      btnEdit.disabled = false;
      btnSave.disabled = false;
    } catch (e) {
      console.error(e);
      showAlert('error', e.message || 'Erreur de génération');
      box.innerHTML = `<div class="opacity-60">Erreur…</div>`;
    } finally {
      btnGenerate.disabled = false;
    }
  }

  async function handleEdit() {
    const prompt = (promptEl?.value || '').trim();
    if (!prompt) return showAlert('warning', 'Écris un prompt pour éditer le SVG.');

    showAlert('info', 'Édition en cours…');
    btnGenerate.disabled = true; btnEdit.disabled = true; btnSave.disabled = true;
    box.innerHTML += `<span class="loading loading-ring loading-lg"></span>`;

    try {
      promptList.push({ role: 'user', content: prompt });

      const aiMsg = await callGenerate(promptList);
      const match = aiMsg.content.match(/<svg[\s\S]*?<\/svg>/i);
      aiMsg.content = match ? match[0] : '';

      promptList.push(aiMsg);

      out.textContent = aiMsg.content;
      box.innerHTML   = aiMsg.content;
      showAlert('success', 'Mise à jour ✅');

      btnSave.disabled = false;
    } catch (e) {
      console.error(e);
      showAlert('error', e.message || 'Erreur lors de l’édition');
    } finally {
      btnGenerate.disabled = false; btnEdit.disabled = false;
    }
  }

  async function saveSVG(params) {
    const res = await fetch('/api/saveSVG', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(params),
    });
    return await res.json();
  }

  btnGenerate?.addEventListener('click', handleSubmit);
  btnEdit?.addEventListener('click', handleEdit);

  btnSave?.addEventListener('click', async () => {
    const name = prompt('Nom de la création :');
    if (!name) return;

    const code = out.textContent || '<svg></svg>';

    const payload = {
      nom: name,
      code_svg: code,
      chat_history: JSON.stringify(promptList),
    };
    const result = await saveSVG(payload);
    if (result?.success) {
      showAlert('success', 'SVG sauvegardé ✅');
    } else {
      showAlert('error', result?.error || 'Erreur à la sauvegarde');
    }
  });
  const copySvgBtn = document.getElementById('copy-svg');

async function copySVG() {
  const code = (out?.textContent || '').trim() || (box?.innerHTML || '').trim();
  if (!code) {
    showAlert('info', 'Rien à copier pour le moment.');
    return;
  }
  try {
    await navigator.clipboard.writeText(code);
    showAlert('success', 'SVG copié dans le presse-papiers ✅');
    copySvgBtn?.classList.add('btn-success');
    setTimeout(() => copySvgBtn?.classList.remove('btn-success'), 900);
  } catch (e) {
    console.error(e);
    showAlert('error', "Impossible de copier le SVG");
  }
}

copySvgBtn?.addEventListener('click', copySVG);

</script>
