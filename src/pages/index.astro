---
import Layout from "../layouts/Layout.astro";
import { ui } from "../i18n/ui.js";

const locale = (Astro.locals.lang ?? 'en');
---

<Layout title={ui[locale].index.title}>
  <div class="flex flex-col h-full items-center justify-center glass bg-primary rounded-box p-10">
    <h1 class="text-4xl lg:text-5xl font-bold mb-4 text-primary-content text-center">
      {ui[locale].index.title}
    </h1>
    <p class="mb-6 text-lg text-primary-content/90 text-center max-w-2xl">
      {ui[locale].index.description}
    </p>
    <a href="/generator" class="btn btn-secondary">{ui[locale].index.button}</a>
  </div>
</Layout>
