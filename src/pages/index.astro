---
import Layout from "../layouts/Layout.astro";
import { ui } from "../i18n/ui.js";
import pb from "../utils/pb";
import { Collections } from "../utils/pocketbase-types";

const locale = (Astro.locals.lang === 'fr' ? 'fr' : 'en');
const user = Astro.locals.user;

let recent = [];
if (user) {
  try {
    recent = await pb.collection(Collections.Svg).getFullList({
      sort: "-created",
      filter: `user = "${user.id}"`, // <- relation vers users
      perPage: 3,
    });
  } catch (e) {
    console.error("PB error on index:", e);
    recent = [];
  }
}
---
<Layout title={ui[locale].index.title}>
  <!-- ton contenu -->
  {user && recent.length > 0 && (
    <div class="mt-6">
      <h2 class="text-lg font-semibold">Vos derniers SVG</h2>
      <ul class="list-disc ml-6">
        {recent.map(r => <li>{r.title ?? r.nom ?? r.id}</li>)}
      </ul>
    </div>
  )}
</Layout>
