---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import pb from "../../utils/pb";
import { Collections, type SvgRecord } from "../../utils/pocketbase-types";

const id = Astro.params.id!;
const svg = await pb.collection(Collections.Svg).getOne<SvgRecord>(id);

// L'historique peut être un JSON ou null
const history =
  Array.isArray(svg.chat_history)
    ? svg.chat_history
    : (svg.chat_history ? JSON.parse(svg.chat_history as any) : []);
---

<Layout>
  <section class="grid gap-6 lg:grid-cols-2">
    <!-- Aperçu SVG -->
    <div class="card bg-base-100 shadow-xl border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Aperçu</h2>
        <div id="svg-preview" class="min-h-64 rounded-box border border-base-300">
          {svg.code_svg && <Fragment set:html={svg.code_svg} />}
        </div>
      </div>
    </div>

    <!-- Chat + form -->
    <div class="card bg-base-100 shadow-xl border border-base-300 relative">
      <div class="card-body">
        <h2 class="card-title">Conversation</h2>

        <div id="chat-history" class="flex flex-col gap-4 w-full mb-20 overflow-y-auto flex-grow">
          {
            history.length
              ? history.map((msg: { role: string; content: string }) => (
                  <div class={`chat ${msg.role === 'user' ? 'chat-start' : 'chat-end'}`}>
                    <div class={`chat-bubble ${msg.role === 'user' ? 'bg-primary text-primary-content' : 'bg-secondary text-secondary-content'}`}>
                      <pre>{msg.content}</pre>
                    </div>
                    <div class="chat-footer opacity-60 text-xs mt-1">{msg.role}</div>
                  </div>
                ))
              : <span class="text-error">Aucun historique.</span>
          }
        </div>
      </div>

      <!-- Formulaire d'édition -->
      <form id="input-prompt-form"
            class="flex flex-col gap-2 w-full absolute bottom-0 left-0 right-0 bg-base-300 p-4"
            autocomplete="off">
        <input type="hidden" name="history" value={JSON.stringify(history)} />
        <input type="hidden" name="id" value={svg.id} />
        <div class="flex items-center gap-2">
          <input id="prompt-input" name="editPrompt" type="text"
                 class="input input-bordered flex-grow"
                 placeholder="Ajoute une fenêtre, change la couleur…" />
          <button class="btn btn-primary" type="submit">Edit</button>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  //@ts-nocheck
  const form = document.getElementById('input-prompt-form');
  const svgPreview = document.getElementById('svg-preview');
  const chatHistory = document.getElementById('chat-history');

  // Utilitaire pour éviter l'injection HTML dans les bulles
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  async function generateSVG(messages) {
    const res = await fetch('/api/generateSVG', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(messages),
    });
    const data = await res.json();
    // l’endpoint TD4 peut renvoyer { svg: { role, content } } ou { svg: '...' }
    return data.svg?.content ?? data.svg ?? '';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const fd = new FormData(form);
    let history;
    try { history = JSON.parse(fd.get('history') || '[]'); }
    catch { history = []; }

    const userText = String(fd.get('editPrompt') || '').trim();
    if (!userText) return;

    const id = String(fd.get('id'));

    // 1) Ajoute le message user en UI
    history.push({ role: 'user', content: userText });
    const userBubble = document.createElement('div');
    userBubble.className = 'chat chat-start';
    userBubble.innerHTML =
      '<div class="chat-bubble bg-primary text-primary-content"><pre>' +
      escapeHtml(userText) +
      '</pre></div><div class="chat-footer opacity-60 text-xs mt-1">user</div>';
    chatHistory.appendChild(userBubble);

    // 2) Loading
    svgPreview.insertAdjacentHTML('beforeend', '<span class="loading loading-ring loading-xl"></span>');

    // 3) Appel API
    let ai = await generateSVG(history);
    const match = String(ai).match(/<svg[\s\S]*?<\/svg>/i);
    const svgCode = match ? match[0] : '';

    // 4) Ajoute la réponse assistant + rendu
    history.push({ role: 'assistant', content: svgCode });
    svgPreview.innerHTML = svgCode;

    const aiBubble = document.createElement('div');
    aiBubble.className = 'chat chat-end';
    aiBubble.innerHTML =
      '<div class="chat-bubble bg-secondary text-secondary-content"><pre>' +
      escapeHtml(svgCode) +
      '</pre></div><div class="chat-footer opacity-60 text-xs mt-1">assistant</div>';
    chatHistory.appendChild(aiBubble);

    // 5) Persistance PocketBase
    try {
      const resp = await fetch('/api/updateSVG', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, code_svg: svgCode, chat_history: history }),
      });
      const ok = await resp.json();
      if (!ok?.success) console.error('update failed', ok);
    } catch (err) {
      console.error('updateSVG error', err);
    }

    // 6) Met à jour le hidden + reset
    form.querySelector('input[name="history"]').value = JSON.stringify(history);
    form.reset();
  });
</script>
